# Pirapire Environment Variables (.env.example)
PORT=3000
NODE_ENV=development

# Database path (Defaults to pirapire.db in root)
DB_PATH=pirapire.db

# Authentication HMAC Secret
AUTH_SECRET=pirapire_auth_secret_key_change_me_in_production_2026

# Payment Gateway Configuration (Pagopar / Bancard / SIPAP Sandbox)
PAYMENT_ENV=SANDBOX
PAYMENT_WEBHOOK_SECRET=pirapire_sandbox_secret_2026
PIRAPIRE_PRO_PRICE_PYG=190000

# Binance Public & Spot Testnet API
BINANCE_PUBLIC_API_URL=https://api.binance.com
BINANCE_TESTNET_API_URL=https://testnet.binance.vision

# Production Real Money Trading Killswitch (STRICTLY FALSE)
ENABLE_PRODUCTION_REAL_TRADING=false
